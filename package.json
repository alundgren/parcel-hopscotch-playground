{
  "name": "parcel-hopscotch-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"vp run dev:server\" \"vp run dev:web\"",
    "dev:server": "vp exec tsx watch --env-file-if-exists=.env.local src/server/main.ts",
    "dev:web": "vp dev",
    "build": "vp run typecheck && NODE_ENV=production vp build && vp exec tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env.local dist/server/server/main.js",
    "typecheck": "vp exec tsc -p tsconfig.json --noEmit && vp exec tsc -p tsconfig.server.json --noEmit",
    "test": "vp test run",
    "test:unit": "vp test run --project=server tests/unit",
    "test:integration": "vp test run --project=server tests/integration",
    "test:e2e": "vp exec playwright test",
    "proof:visual": "rm -rf artifacts/visual && VISUAL_PROOF=true vp test run --project=browser-*",
    "proof:video": "RECORD_VIDEO=true PROOF_DEMO=true vp exec playwright test tests/e2e/acceptance.spec.ts --grep 'rejects a stale batch|records server-turn'",
    "benchmark:providers": "vp exec tsx --env-file-if-exists=.env.local src/server/provider-benchmark-cli.ts",
    "smoke:providers": "vp exec tsx src/server/provider-smoke.ts",
    "smoke:agent": "vp exec tsx src/server/provider-smoke.ts",
    "verify:container": "node scripts/verify-container.mjs",
    "check": "vp run typecheck && vp test run && vp run test:qa",
    "qa": "node scripts/qa.mjs",
    "test:qa": "vp run build && node --test tools/qa-loop/core.test.mjs qa/parcel/adapter.test.mjs tests/qa/workflow.node-test.mjs",
    "test:live": "node scripts/live-acceptance.mjs",
    "test:browser": "vp test run --project=browser-*",
    "benchmark:tests": "node scripts/benchmark-tests.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/sql-sqlite-node": "4.0.0-rc.117",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-rc.117",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/ui": "5.0.1",
    "concurrently": "9.2.1",
    "playwright": "1.62.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@12.5.0"
}
